# ==============================================================================
# AlphaNSE - Angel One SmartAPI Environment Configuration Template
# ==============================================================================
# Instructions:
# 1. Copy this file to '.env': `copy .env.angel.example .env`
# 2. Fill in your Angel One SmartAPI App Key, Client Code, Trading PIN, and TOTP Secret.
# 3. Keep LIVE_TRADING and ALLOW_REAL_ORDERS set to False for read-only validation.
# 4. NEVER commit '.env' to git or share it.
# ==============================================================================

# Angel One SmartAPI Credentials
ANGEL_API_KEY=YOUR_SMARTAPI_KEY
ANGEL_CLIENT_CODE=YOUR_CLIENT_CODE
ANGEL_PIN=YOUR_4_DIGIT_PIN
ANGEL_TOTP_SECRET=YOUR_AUTHENTICATOR_TOTP_SECRET

# Dual-Key Fail-Closed Safety Gates
# BOTH must be explicitly set to True to allow real money order execution.
LIVE_TRADING=False
ALLOW_REAL_ORDERS=False

# Pre-Trade Capital & Risk Hard Limits
MAX_CAPITAL_ALLOCATED=1500.00
MAX_DAILY_LOSS=30.00
MAX_OPEN_POSITIONS=1
