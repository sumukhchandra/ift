# ==============================================================================
# AlphaNSE V3 Cloud & Local Deployment Environment Configuration Template
# ==============================================================================
# INSTRUCTIONS:
# 1. Copy this file to '.env' in the project root: `cp .env.example .env` (Linux/Mac) or `copy .env.example .env` (Windows)
# 2. Fill in your actual credentials.
# 3. NEVER commit your actual '.env' file or broker secrets to GitHub.
# ==============================================================================

# Kotak Neo Trade API Credentials
# Used by the AlphaNSE V3 engine (kotak_adapter.py) for authenticating live market data feeds
KOTAK_CONSUMER_KEY=your_kotak_consumer_key_here
KOTAK_MOBILE_NUMBER=your_registered_mobile_number_here
KOTAK_UCC=your_kotak_ucc_here
KOTAK_MPIN=your_6_digit_mpin_here
KOTAK_TOTP_SECRET=your_base32_totp_secret_here

# Optional: Kotak Consumer Secret (if using Neo Trade API v2 secret flow)
KOTAK_CONSUMER_SECRET=your_kotak_consumer_secret_here

# Dual-Key Independent Fail-Closed Trading Safety Gates
# BOTH values MUST remain False for paper/shadow mode. Live orders will be blocked if either is False.
LIVE_TRADING=False
ALLOW_REAL_ORDERS=False

# Pre-Trade Capital & Risk Hard Limits (Enforced by AlphaNSELiveTrader)
MAX_CAPITAL_ALLOCATED=1500.00
MAX_DAILY_LOSS=30.00
MAX_OPEN_POSITIONS=1
CASH_ONLY=True

# Cloud Persistence (Render PostgreSQL / External DB)
# When set, both the background worker and Streamlit web dashboard sync via PostgreSQL.
# If unset, the system gracefully falls back to local SQLite at reports/live/alphanse_local.db
# Example Render format: postgresql://alphanse_db_user:password@dpg-xxxxxx-a.oregon-postgres.render.com/alphanse_db
DATABASE_URL=

# Streamlit Web Service Configuration (Render sets PORT automatically)
PORT=8501
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_ADDRESS=0.0.0.0
STREAMLIT_SERVER_HEADLESS=true
